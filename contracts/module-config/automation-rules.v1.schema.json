{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Automation Rules Module Config v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rules"
  ],
  "properties": {
    "rules": {
      "type": "array",
      "minItems": 1,
      "$comment": "jarvis:automation-rule-set",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "when",
          "emit"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "when": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "eventType"
            ],
            "properties": {
              "eventType": {
                "title": "Input Fact",
                "description": "Versioned Fact selected from project-scoped composition choices.",
                "type": "string",
                "minLength": 3,
                "$comment": "jarvis:event-kind=fact"
              },
              "equals": {
                "title": "Bounded match",
                "description": "Exact scalar payload fields that must match before emission.",
                "type": "object",
                "$comment": "jarvis:bounded-match",
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                }
              }
            }
          },
          "emit": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "target"
            ],
            "properties": {
              "type": {
                "title": "Emitted Request",
                "description": "Versioned Request selected from project-scoped composition choices.",
                "type": "string",
                "minLength": 3,
                "$comment": "jarvis:event-kind=request"
              },
              "target": {
                "title": "Resolved consumer",
                "description": "Project-scoped binding or Module Instance resolved by the Engine.",
                "type": "object",
                "$comment": "jarvis:request-target",
                "additionalProperties": false,
                "properties": {
                  "binding": {
                    "type": "string",
                    "minLength": 1
                  },
                  "moduleInstanceId": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "oneOf": [
                  {
                    "required": [
                      "binding"
                    ]
                  },
                  {
                    "required": [
                      "moduleInstanceId"
                    ]
                  }
                ]
              },
              "payload": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  }
}
