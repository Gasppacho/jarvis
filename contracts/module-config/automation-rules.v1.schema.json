{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Automation Rules Module Config v1",
  "description": "Fact matching and targeted Request emission for one Automation Rules Module Instance.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rules"
  ],
  "properties": {
    "rules": {
      "title": "Automation Rules",
      "description": "Ordered, repeatable Fact-to-Request rules.",
      "type": "array",
      "minItems": 1,
      "$comment": "jarvis:automation-rule-set",
      "items": {
        "title": "Automation Rule",
        "description": "When a Fact matches, emit one targeted Request.",
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "when",
          "emit"
        ],
        "properties": {
          "id": {
            "title": "Rule ID",
            "description": "Stable identifier for this Rule within the Rule Set.",
            "type": "string",
            "examples": [
              "agent-ready"
            ],
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "when": {
            "title": "When",
            "description": "The input Fact and optional bounded payload match.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "eventType"
            ],
            "properties": {
              "eventType": {
                "title": "Input Fact",
                "description": "Versioned Fact selected from project-scoped composition choices.",
                "type": "string",
                "examples": [
                  "scm.work-item.tag-added"
                ],
                "minLength": 3,
                "$comment": "jarvis:event-kind=fact"
              },
              "equals": {
                "title": "Bounded match",
                "description": "Exact scalar payload fields that must match before emission.",
                "type": "object",
                "examples": [
                  {
                    "payload.tag": "agent:ready"
                  }
                ],
                "$comment": "jarvis:bounded-match",
                "additionalProperties": {
                  "type": [
                    "string",
                    "number",
                    "boolean",
                    "null"
                  ]
                }
              }
            }
          },
          "emit": {
            "title": "Emit",
            "description": "The Request, target, and optional payload emitted by this Rule.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "target"
            ],
            "properties": {
              "type": {
                "title": "Emitted Request",
                "description": "Versioned Request selected from project-scoped composition choices.",
                "type": "string",
                "examples": [
                  "development.implementation.requested"
                ],
                "minLength": 3,
                "$comment": "jarvis:event-kind=request"
              },
              "target": {
                "title": "Resolved consumer",
                "description": "Project-scoped binding or Module Instance resolved by the Engine.",
                "type": "object",
                "$comment": "jarvis:request-target",
                "additionalProperties": false,
                "properties": {
                  "binding": {
                    "title": "Binding",
                    "description": "Project binding that resolves the Request consumer.",
                    "type": "string",
                    "examples": [
                      "development"
                    ],
                    "minLength": 1
                  },
                  "moduleInstanceId": {
                    "title": "Module Instance",
                    "description": "Explicit compatible consumer Module Instance ID.",
                    "type": "string",
                    "examples": [
                      "development"
                    ],
                    "minLength": 1
                  }
                },
                "oneOf": [
                  {
                    "required": [
                      "binding"
                    ]
                  },
                  {
                    "required": [
                      "moduleInstanceId"
                    ]
                  }
                ]
              },
              "payload": {
                "title": "Request payload",
                "description": "Static JSON object merged into the emitted Request payload.",
                "type": "object",
                "examples": [
                  {}
                ]
              }
            }
          }
        }
      }
    }
  }
}
