{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Development Module Config v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "validationOrder",
    "maxRepairCycles"
  ],
  "properties": {
    "validationOrder": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "lint",
          "typecheck",
          "test",
          "build"
        ]
      }
    },
    "maxRepairCycles": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "retainWorkspaceOnSuccess": {
      "type": "boolean",
      "default": false
    }
  }
}
