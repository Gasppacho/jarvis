{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Work item tags change requested",
  "description": "Requests additive and subtractive label changes on a source-control Work Item.",
  "type": "object",
  "additionalProperties": false,
  "required": ["repositoryId", "workItemRef", "addTags", "removeTags"],
  "properties": {
    "repositoryId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "workItemRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "addTags": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "removeTags": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "minItems": 0,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    }
  },
  "anyOf": [
    { "properties": { "addTags": { "type": "array", "minItems": 1 } } },
    { "properties": { "removeTags": { "type": "array", "minItems": 1 } } }
  ]
}
