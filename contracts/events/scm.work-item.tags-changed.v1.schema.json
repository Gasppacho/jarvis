{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Work item tags changed",
  "description": "Reports the verified labels after a source-control Work Item mutation.",
  "type": "object",
  "additionalProperties": false,
  "required": ["repositoryId", "workItemRef", "addTags", "removeTags", "observedTags"],
  "properties": {
    "repositoryId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "workItemRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "addTags": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "removeTags": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "observedTags": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    }
  }
}
