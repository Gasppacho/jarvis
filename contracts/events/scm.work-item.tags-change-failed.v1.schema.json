{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Work item tags change failed",
  "description": "Reports a safe classified failure while changing Work Item labels.",
  "type": "object",
  "additionalProperties": false,
  "required": ["repositoryId", "workItemRef", "addTags", "removeTags", "errorCode", "retryable"],
  "properties": {
    "repositoryId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "workItemRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "addTags": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "removeTags": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "errorCode": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$",
      "maxLength": 200
    },
    "retryable": { "type": "boolean" }
  }
}
