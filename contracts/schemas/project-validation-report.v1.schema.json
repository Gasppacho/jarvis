{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.dev/schemas/project-validation-report.v1.schema.json",
  "title": "Jarvis Project Validation Report v1",
  "$defs": {
    "validationContract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "version", "kind"],
      "properties": {
        "type": { "type": "string" },
        "version": { "type": "integer", "minimum": 1 },
        "kind": { "enum": ["request", "fact"] }
      }
    },
    "instanceTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instanceId", "moduleId"],
      "properties": {
        "instanceId": { "type": "string" },
        "moduleId": { "type": "string" }
      }
    },
    "contractEndpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instanceId", "moduleId", "contract"],
      "properties": {
        "instanceId": { "type": "string" },
        "moduleId": { "type": "string" },
        "contract": { "$ref": "#/$defs/validationContract" }
      }
    },
    "projectFindingTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "field"],
      "properties": {
        "kind": { "const": "project" },
        "field": { "type": "string" }
      }
    },
    "requestEdgeFindingTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "contract", "producer"],
      "properties": {
        "kind": { "const": "request-edge" },
        "contract": { "$ref": "#/$defs/validationContract" },
        "producer": { "$ref": "#/$defs/instanceTarget" },
        "candidates": {
          "type": "array",
          "items": { "$ref": "#/$defs/instanceTarget" }
        }
      }
    },
    "contractEdgeFindingTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "producer", "consumer"],
      "properties": {
        "kind": { "const": "contract-edge" },
        "producer": { "$ref": "#/$defs/contractEndpoint" },
        "consumer": { "$ref": "#/$defs/contractEndpoint" }
      }
    },
    "moduleInstanceFindingTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "instanceId", "field"],
      "properties": {
        "kind": { "const": "module-instance" },
        "instanceId": { "type": "string" },
        "field": { "type": "string" }
      }
    },
    "slotFindingTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "slot"],
      "properties": {
        "kind": { "const": "slot" },
        "slot": { "type": "string" }
      }
    },
    "moduleCapabilityFindingTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "capability", "instanceId"],
      "properties": {
        "kind": { "const": "capability" },
        "capability": { "type": "string" },
        "instanceId": { "type": "string" },
        "binding": { "type": "string" }
      }
    },
    "slotCapabilityFindingTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "capability", "slot"],
      "properties": {
        "kind": { "const": "capability" },
        "capability": { "type": "string" },
        "slot": { "type": "string" }
      }
    }
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "projectId",
    "valid",
    "requestRoutes",
    "satisfiedCapabilities",
    "findings"
  ],
  "properties": {
    "apiVersion": {
      "const": "jarvis.dev/project-validation/v1"
    },
    "kind": {
      "const": "ProjectValidationReport"
    },
    "projectId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "valid": {
      "type": "boolean"
    },
    "requestRoutes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contract", "producer", "consumer"],
        "properties": {
          "contract": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "version", "kind"],
            "properties": {
              "type": { "type": "string" },
              "version": { "type": "integer", "minimum": 1 },
              "kind": { "const": "request" }
            }
          },
          "producer": {
            "type": "object",
            "additionalProperties": false,
            "required": ["instanceId", "moduleId"],
            "properties": {
              "instanceId": { "type": "string" },
              "moduleId": { "type": "string" }
            }
          },
          "consumer": {
            "type": "object",
            "additionalProperties": false,
            "required": ["instanceId", "moduleId"],
            "properties": {
              "instanceId": { "type": "string" },
              "moduleId": { "type": "string" }
            }
          }
        }
      }
    },
    "satisfiedCapabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "target", "source"],
        "properties": {
          "capability": { "type": "string" },
          "target": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "instanceId"],
                "properties": {
                  "kind": { "const": "module-instance" },
                  "instanceId": { "type": "string" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["kind", "slot"],
                "properties": {
                  "kind": { "const": "slot" },
                  "slot": { "type": "string" }
                }
              }
            ]
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "ref"],
            "properties": {
              "kind": {
                "enum": ["connection", "runtime", "mcp", "module-instance", "engine", "repository"]
              },
              "ref": { "type": "string" }
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "message", "target"],
        "properties": {
          "code": {
            "enum": [
              "project.composition-incomplete",
              "project.binding-missing",
              "project.capability-unresolved",
              "project.contract-incompatible",
              "project.instance-config-invalid",
              "project.module-package-unavailable",
              "project.request-ambiguous",
              "project.request-orphaned"
            ]
          },
          "severity": { "enum": ["error", "warning"] },
          "message": { "type": "string", "minLength": 1 },
          "target": {
            "oneOf": [
              { "$ref": "#/$defs/projectFindingTarget" },
              { "$ref": "#/$defs/requestEdgeFindingTarget" },
              { "$ref": "#/$defs/contractEdgeFindingTarget" },
              { "$ref": "#/$defs/moduleInstanceFindingTarget" },
              { "$ref": "#/$defs/slotFindingTarget" },
              { "$ref": "#/$defs/moduleCapabilityFindingTarget" },
              { "$ref": "#/$defs/slotCapabilityFindingTarget" }
            ]
          }
        }
      }
    },
    "compositionFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Stable digest of exactly the Portable Configuration and Local Bindings this report describes. POST /v1/projects/{projectId}/activate takes it back and refuses activation when it no longer matches what is saved right now, instead of silently revalidating a stale report."
    }
  }
}
