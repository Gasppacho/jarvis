{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.dev/schemas/project-config.v1.schema.json",
  "title": "Jarvis Project Config v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "repositories",
    "slots",
    "commands",
    "git",
    "workspace",
    "modules"
  ],
  "properties": {
    "apiVersion": {
      "const": "jarvis.dev/project/v1"
    },
    "kind": {
      "const": "Project"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "maxLength": 100
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "root",
          "defaultBranch",
          "remote"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "root": {
            "type": "string",
            "const": "."
          },
          "defaultBranch": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "remote": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      }
    },
    "slots": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requires"
        ],
        "properties": {
          "requires": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "optional": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "install": {
          "type": "string",
          "minLength": 1
        },
        "lint": {
          "type": "string",
          "minLength": 1
        },
        "typecheck": {
          "type": "string",
          "minLength": 1
        },
        "test": {
          "type": "string",
          "minLength": 1
        },
        "build": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branchPattern",
        "commitStrategy",
        "pushRemote"
      ],
      "properties": {
        "branchPattern": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "commitStrategy": {
          "enum": [
            "conventional",
            "ticket-prefix",
            "freeform"
          ]
        },
        "pushRemote": {
          "type": "string",
          "minLength": 1
        },
        "allowForcePush": {
          "const": false
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy",
        "maxConcurrentExecutions",
        "retainOnFailureDays"
      ],
      "properties": {
        "strategy": {
          "const": "git-worktree"
        },
        "maxConcurrentExecutions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "retainOnFailureDays": {
          "type": "integer",
          "minimum": 0,
          "maximum": 90
        }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instanceId",
          "moduleId",
          "enabled"
        ],
        "properties": {
          "instanceId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "moduleId": {
            "type": "string",
            "pattern": "^jarvis\\.module\\.[a-z0-9-]+$"
          },
          "enabled": {
            "type": "boolean"
          },
          "runtimeSlot": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
          },
          "bindings": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
            }
          },
          "configuration": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  }
}
