{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.dev/schemas/project-config.v1.schema.json",
  "title": "Jarvis Project Config v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "repositories",
    "slots",
    "modules"
  ],
  "properties": {
    "apiVersion": {
      "const": "jarvis.dev/project/v1"
    },
    "kind": {
      "const": "Project"
    },
    "compositionMode": {
      "type": "string",
      "enum": ["fixed-modules"]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$",
          "maxLength": 100
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 500
        }
      }
    },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "root"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "root": {
            "type": "string",
            "const": "."
          }
        }
      }
    },
    "slots": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requires"
        ],
        "properties": {
          "requires": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "optional": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instanceId",
          "moduleId",
          "enabled"
        ],
        "properties": {
          "instanceId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "moduleId": {
            "type": "string",
            "pattern": "^jarvis\\.module\\.[a-z0-9-]+$"
          },
          "enabled": {
            "type": "boolean"
          },
          "runtimeSlot": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
          },
          "bindings": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9._-]*$"
            }
          },
          "configuration": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    }
  }
}
